---
import { formatDate, withBase } from '~/lib/utils'
import Prose from '~/components/posts/base/Prose.astro'

interface Props {
  frontmatter: any
  minutesRead?: string
  wordCount?: number
}

const { frontmatter, minutesRead } = Astro.props
---

<article class="blog-post-page">
  <div class="blog-article">
    <header class="blog-article-header">
      <nav class="blog-breadcrumb" aria-label="현재 위치">
        <a href={withBase('/')}>홈</a><span aria-hidden="true">/</span>
        <a href={withBase('/posts')}>글</a><span aria-hidden="true">/</span>
        <span>읽기</span>
      </nav>
      {frontmatter.tags?.[0] && <span class="blog-article-kicker"># {frontmatter.tags[0]}</span>}
      <h1 data-pagefind-body>{frontmatter.title}</h1>
      {frontmatter.description && <p class="blog-article-summary">{frontmatter.description}</p>}
      <div class="blog-article-author">
        <img src={withBase('/brand/blog/glasses.png')} alt="" width="34" height="34" />
        <strong>{frontmatter.author || 'Meety Team'}</strong>
        <span aria-hidden="true">·</span>
        <time datetime={frontmatter.pubDate.toISOString()}>{formatDate(frontmatter.pubDate)}</time>
        {minutesRead && <><span aria-hidden="true">·</span><span>{minutesRead}분 읽기</span></>}
      </div>
    </header>

    <div class="blog-article-body"><Prose><slot /></Prose></div>

    {frontmatter.tags?.length > 0 && (
      <nav class="blog-article-tags" aria-label="이 글의 태그">
        {frontmatter.tags.map((tag: string) => <a class="blog-topic-link" href={withBase(`/tags/${tag}`)}># {tag}</a>)}
      </nav>
    )}
    <div class="blog-article-actions">
      <button class="blog-copy-link" id="blog-copy-link" type="button" aria-label="글 링크 복사">
        <span aria-hidden="true">↗</span><span>링크 복사</span>
      </button>
    </div>
  </div>
</article>
