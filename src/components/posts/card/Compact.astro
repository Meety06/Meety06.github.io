---
import { formatDate, withBase } from '~/lib/utils'
import type { CardProps } from './List.astro'

interface Props extends CardProps {}

const { post, class: className, style }: Props = Astro.props
---

<a href={withBase(`/posts/${post.id}`)} class:list={['blog-post-row', className]} {style}>
  <time class="blog-post-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
  <div>
    <h3 class="blog-post-title">{post.data.title}</h3>
    {post.data.description && <p class="blog-post-desc">{post.data.description}</p>}
    <div class="blog-post-meta">
      {post.data.tags?.slice(0, 4).map((tag) => <span class="blog-tag"># {tag}</span>)}
    </div>
  </div>
  <span class="blog-post-arrow" aria-hidden="true">↗</span>
</a>
