---
import { withBase } from '~/lib/utils'

const currentYear = new Date().getFullYear()
---

<footer class="blog-footer">
  <div class="blog-shell blog-footer-inner">
    <div class="blog-footer-brand">
      <span class="blog-brand-mark" aria-hidden="true">M</span>
      <div><strong>Meety Tech Blog</strong><p>회의가 끝나도 남는 기술을 기록합니다.</p></div>
    </div>
    <nav aria-label="바닥글">
      <a href={withBase('/posts')}>글</a>
      <a href={withBase('/tags')}>태그</a>
      <a href={withBase('/team')}>팀원 소개</a>
      <a href={withBase('/rss.xml')}>RSS</a>
      <a href="https://github.com/Meety06/Meety06.github.io" target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
    <small>© {currentYear} Meety Team</small>
  </div>
</footer>
