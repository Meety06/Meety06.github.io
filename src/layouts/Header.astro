---
import ThemeToggle from '~/components/theme/ThemeToggle'
import SearchSwitch from '~/components/base/SearchSwitch.astro'
import { withBase } from '~/lib/utils'
---

<header class="blog-header">
  <div class="blog-shell blog-header-inner">
    <a href={withBase('/')} class="blog-brand" aria-label="Meety Tech Blog 홈">
      <span class="blog-brand-mark" aria-hidden="true">M</span>
      <span class="blog-brand-name">Meety <span>Tech</span></span>
    </a>
    <nav class="blog-nav" aria-label="주 메뉴">
      <a href={withBase('/posts')}>글</a>
      <a href={withBase('/tags')}>태그</a>
      <a href={withBase('/#about')}>팀 소개</a>
    </nav>
    <div class="blog-header-actions">
      <SearchSwitch />
      <a class="blog-icon-button blog-rss-link" href={withBase('/rss.xml')} aria-label="RSS 피드">
        <span class="icon-[tabler--rss] size-5" aria-hidden="true"></span>
      </a>
      <div class="blog-theme-toggle"><ThemeToggle client:load /></div>
    </div>
  </div>
</header>
