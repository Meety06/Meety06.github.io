---
import Layout from '~/layouts/Layout.astro'
import { getAllPosts, getAllTags } from '~/lib/data'
import { withBase } from '~/lib/utils'

const [tagsMap, posts] = await Promise.all([getAllTags(), getAllPosts()])
const tags = Object.entries(tagsMap).sort((a, b) => b[1] - a[1])
---

<Layout title="태그" description="Meety 기술 블로그의 주제별 글 모음">
  <div class="blog-shell blog-list-page">
    <p class="blog-eyebrow">EXPLORE BY TOPIC</p>
    <h1>관심 있는 기술부터</h1>
    <p class="blog-list-intro">Meety 팀이 다루는 {tags.length}개 주제에서 {posts.length}편의 글을 찾아보세요.</p>
    <div class="blog-tag-grid">
      {tags.map(([tag, count]) => (
        <a class="blog-tag-card" href={withBase(`/tags/${tag}`)}>
          <span># {tag}</span><small>{count}편의 글</small><span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</Layout>
