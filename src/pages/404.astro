---
import Layout from '~/layouts/Layout.astro'
import { withBase } from '~/lib/utils'
---

<Layout title="페이지를 찾을 수 없어요" description="요청한 페이지를 찾을 수 없습니다.">
  <div class="blog-not-found">
    <img src={withBase('/brand/blog/sad.png')} alt="" width="220" height="220" />
    <p class="blog-eyebrow">404 · PAGE NOT FOUND</p>
    <h1>이 페이지는 찾을 수 없어요</h1>
    <p>주소가 바뀌었거나 아직 작성 중인 글일 수 있어요.<br />다른 기술 이야기를 보러 가볼까요?</p>
    <a href={withBase('/')}>홈으로 돌아가기 →</a>
  </div>
</Layout>
