---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { POSTS_CONFIG } from '~/config'
import { getAllPosts } from '~/lib/data'
import Layout from '~/layouts/Layout.astro'
import Pagination from '~/components/base/Pagination.astro'
import List from '~/components/posts/card/List.astro'
import { withBase } from '~/lib/utils'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const sortedPosts = await getAllPosts()

  return paginate(sortedPosts, {
    pageSize: POSTS_CONFIG.postPageConfig.size,
  })
}

interface Props {
  page: Page<CollectionEntry<'posts'>>
}

const { page } = Astro.props

const { title, description } = POSTS_CONFIG
const allPosts = await getAllPosts()
const tagCounts = allPosts.flatMap((post) => post.data.tags ?? []).reduce((counts, tag) => {
  counts.set(tag, (counts.get(tag) ?? 0) + 1)
  return counts
}, new Map<string, number>())
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10)
---

<Layout {title} {description}>
  <div class="blog-shell blog-list-page">
    <p class="blog-eyebrow">MEETY ENGINEERING</p>
    <h1>모든 글</h1>
    <p class="blog-list-intro">Meety를 만들며 얻은 기술적 배움과 팀의 경험을 기록합니다.</p>
    <nav class="blog-topic-row" aria-label="글 주제">
      <a class="blog-topic-link active" href={withBase('/posts')}>전체 <span>{allPosts.length}</span></a>
      {tags.map(([tag, count]) => <a class="blog-topic-link" href={withBase(`/tags/${tag}`)}>{tag} <span>{count}</span></a>)}
    </nav>
    <List posts={page.data} type="compact" />
    <Pagination {page} baseUrl="/posts" />
  </div>
</Layout>
