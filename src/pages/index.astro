---
import { POSTS_CONFIG, SITE } from '~/config'
import Layout from '~/layouts/Layout.astro'
import SectionDivider from '~/components/base/SectionDivider.astro'
import List from '~/components/posts/card/List.astro'
import { getNumPosts, getPinnedPosts } from '~/lib/data'

const pinnedPosts = await getPinnedPosts()
const showPosts = pinnedPosts.length > 0 ? pinnedPosts : await getNumPosts(POSTS_CONFIG.homePageConfig.size)
---

<Layout title="홈" description={SITE.description}>
  <div class="relative z-[1]">
    <div class="py-8 pb-10 px-6 sm:px-8">
      <h1 class="flex flex-col gap-2">
        <span class="text-4xl sm:text-5xl tracking-tight">Meety</span>
        <span class="text-muted-foreground font-light text-xl sm:text-2xl block tracking-wide">Tech Blog</span>
      </h1>
      <ul class="mt-6 flex flex-wrap gap-2" aria-label="팀 구성">
        {
          ['Frontend · 2', 'Backend · 1', 'AI · 1', 'Infra · 1'].map((role) => (
            <li class="border border-border px-3 py-1 text-sm">{role}</li>
          ))
        }
      </ul>
    </div>

    <SectionDivider />
    <div class="py-8 pb-10 px-6 sm:px-8">
      <h2 class="text-2xl sm:text-3xl tracking-tight">최근 글</h2>
      <List posts={showPosts} type={POSTS_CONFIG.homePageConfig.type} />
    </div>
  </div>
</Layout>
